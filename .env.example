# Copy to .env for local Compose. Use a secret manager for shared/prod deployments.
APP_ENV=development
API_BEARER_TOKEN=replace_with_a_long_random_api_token
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini
HUBSPOT_ACCESS_TOKEN=replace_me
HUBSPOT_API_VERSION=2026-09
DAILY_MODEL_CALL_LIMIT=100
MAX_WEBSITE_BYTES=1500000
WEBSITE_TIMEOUT_SECONDS=12
SCORE_POLICY_PATH=config/qualification_policy.json

DB_NAME=lead_agent
DB_BOOTSTRAP_PASSWORD=replace_with_long_random_password
DB_MIGRATION_USER=lead_migrator
DB_MIGRATION_PASSWORD=replace_with_another_long_random_password
DB_USER=lead_agent_app
DB_PASSWORD=replace_with_a_third_long_random_password
